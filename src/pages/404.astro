---
import Layout from '../layouts/Layout.astro';
import { path } from '../lib/paths';
import '../styles/pages.css';
---

<Layout title="Page not found">
  <div class="wrap page">
    <h1>Nothing here.</h1>
    <p class="links">
      <a class="textlink" href={path()}>
        Home
      </a>
      <a class="textlink" href={path('work/')}>
        Work
      </a>
    </p>
  </div>
</Layout>
