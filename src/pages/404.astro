---
import Layout from '../layouts/Layout.astro';
import { path } from '../lib/paths';
---

<Layout title="Page not found">
  <div class="wrap">
    <section class="page-intro">
      <p class="eyebrow">404 / PAGE NOT FOUND</p>
      <h1>A different direction.</h1>
      <p>This page could not be found. Return to the homepage or explore selected work.</p>
      <div class="actions">
        <a class="button" href={path()}>
          Back to home
        </a>
        <a class="text-link" href={path('work/')}>
          Selected work ↗
        </a>
      </div>
    </section>
  </div>
</Layout>
