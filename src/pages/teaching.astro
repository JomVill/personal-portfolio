---
import Layout from '../layouts/Layout.astro';
import { teaching, engagements } from '../data/profile';
import SectionHeader from '../components/SectionHeader.astro';
---
<Layout title="Teaching & engagement"><div class="wrap"><section class="page-intro"><p class="eyebrow">TEACHING / CAPACITY BUILDING</p><h1>Learn the fundamentals.<br/>Build with purpose.</h1><p>Teaching computing means connecting concepts with the systems students can design, question, and improve.</p></section><section class="section teaching-preview"><div><p class="eyebrow">MSU-IIT</p><h2>Applied learning.<br/>Connected practice.</h2><p>I teach in the Department of Computer Applications, College of Computer Studies. My teaching areas connect programming and computing foundations with sensors, devices, automation, and data.</p></div><div class="course-list">{teaching.map((course, i) => <div><span class="meta">0{i + 1}</span><span>{course}</span></div>)}</div></section><section class="section"><SectionHeader number="AI READY ASEAN" title="Understanding AI together."/><p class="section-intro">As a Certified AI READY ASEAN Master Trainer, my work includes AI literacy, educator capacity building, professional training, and regional AI literacy initiatives.</p>{engagements.map(e => <article class="engagement"><span class="meta">{e.date}</span><div><h3><a href={e.url}>{e.title} ↗</a></h3><p>{e.text}</p><span class="meta">{e.role}</span></div></article>)}</section></div></Layout>
