---
import Layout from '../../layouts/Layout.astro';
import WorkflowCard from '../../components/WorkflowCard.astro';
import { getWorkflows } from '../../lib/workflows';
import { workGroups } from '../../data/workflow-copy';
import '../../styles/work.css';

const all = getWorkflows();
const groups = workGroups.map((g) => ({ ...g, items: all.filter((w) => w.group === g.id) }));
---

<Layout title="Workflows">
  <div class="wrap work-head">
    <h1>Workflows I built</h1>
    <p class="lede">
      Each one is built in Zapier and can be replicated in n8n, with AI doing the reading and a person
      approving what matters.
    </p>
  </div>
  {groups.map((g) => (
    <section class="wrap work-group" aria-labelledby={`group-${g.id}`}>
      <div class="work-group-head">
        <h2 id={`group-${g.id}`}>{g.title}</h2>
        <p>{g.text}</p>
      </div>
      <div class="cards">
        {g.items.map((w) => (
          <WorkflowCard workflow={w} />
        ))}
      </div>
    </section>
  ))}
</Layout>
