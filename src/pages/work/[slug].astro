---
// Placeholder until Task 6 builds the workflow detail pages.
import Layout from '../../layouts/Layout.astro';
import { getWorkflows, type Workflow } from '../../lib/workflows';
export function getStaticPaths() {
  return getWorkflows().map((workflow) => ({ params: { slug: workflow.slug }, props: { workflow } }));
}
const { workflow } = Astro.props as { workflow: Workflow };
---

<Layout title={workflow.title}>
  <div class="wrap">
    <section>
      <h1>{workflow.title}</h1>
    </section>
  </div>
</Layout>
