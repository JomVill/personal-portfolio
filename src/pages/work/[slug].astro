---
import Layout from '../../layouts/Layout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { projects } from '../../data/projects';
import { path } from '../../lib/paths';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project: p } = Astro.props;
---
<Layout title={p.title} description={p.summary}><div class="wrap"><section class="page-intro"><a class="back-link" href={path('work/')}>← Selected work</a><p class="eyebrow">{p.number} / {p.category}</p><h1>{p.title}</h1><p>{p.summary}</p></section><div class="wide-visual"><ProjectVisual kind={p.visual}/></div><section class="section detail-grid"><dl><dt>CONTEXT</dt><dd>{p.organization}</dd><dt>ROLE</dt><dd>{p.role}</dd></dl><div class="prose"><h2>Objective</h2><p>{p.objective}</p><h2>Contribution</h2><p>{p.contribution}</p><h2>Methods & areas</h2><div class="tag-list">{p.methods.map(method => <span class="tag">{method}</span>)}</div><h2>Work & outcomes</h2><p>{p.result}</p>{p.link && <a class="text-link" href={p.link}>Read the source ↗</a>}</div></section><section class="section"><a class="text-link" href={path(`work/${projects[(projects.findIndex(item => item.slug === p.slug) + 1) % projects.length].slug}/`)}>Explore the next initiative →</a></section></div></Layout>
