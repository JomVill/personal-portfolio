---
import Layout from '../layouts/Layout.astro';
import { profile, experience, teaching, education, training, presentations } from '../data/profile';
import { publications } from '../data/publications';
import '../styles/pages.css';
---

<Layout title="Curriculum vitae">
  <div class="wrap page">
    <header>
      <h1>{profile.academicName}</h1>
      <p class="lede">Assistant Professor. AI automation, technology policy, and applied research.</p>
      <div class="cv-actions">
        <button class="key key-orange key-sm" id="print-profile" type="button">
          Print / save CV as PDF
        </button>
        <a class="textlink" href={`mailto:${profile.email}`}>
          {profile.email}
        </a>
      </div>
    </header>
    <section>
      <h2>Profile</h2>
      <p>
        Faculty member, researcher, and technology practitioner working across AI automation, IoT, education,
        technology policy, and digital governance. Experience includes AI-powered workflows, multi-agent
        systems, applied computing, and emerging technology research.
      </p>
    </section>
    <section>
      <h2>Professional experience</h2>
      <div>
        {experience.map((e) => (
          <article class="experience">
            <div class="item-head">
              <h3>{e.role}</h3>
              <span class="meta">{e.dates}</span>
            </div>
            <span class="meta">{e.organization}</span>
            <p>{e.detail}</p>
          </article>
        ))}
      </div>
    </section>
    <section>
      <h2>Education</h2>
      <div>
        {education.map((e) => (
          <article class="experience">
            <div class="item-head">
              <h3>{e.degree}</h3>
              <span class="meta">{e.dates}</span>
            </div>
            <p>
              {e.institution}
              <br />
              {e.detail}
            </p>
          </article>
        ))}
      </div>
    </section>
    <section>
      <h2>Publications</h2>
      {publications.map((p) => (
        <article class="experience">
          <div class="item-head">
            <h3>{p.title}</h3>
            <span class="meta">
              {p.type}, {p.year}
            </span>
          </div>
          <p>
            {p.authors}
            <br />
            {p.venue}
            <br />
            <a href={`https://doi.org/${p.doi}`}>DOI: {p.doi}</a>
          </p>
        </article>
      ))}
    </section>
    <section>
      <h2>Conference presentation</h2>
      <div>
        {presentations.map((p) => (
          <article class="experience">
            <div class="item-head">
              <h3>{p.title}</h3>
              <span class="meta">{p.date}</span>
            </div>
            <p>
              {p.type}, {p.event}
              <br />
              {p.location}
            </p>
          </article>
        ))}
      </div>
    </section>
    <section>
      <h2>Teaching & technical practice</h2>
      <div>
        <p>{teaching.join(', ')}</p>
        <p>
          Zapier, n8n, APIs, LLMs, AI agent workflows, Claude Code, Codex, embedded systems, IoT sensor
          networks
        </p>
      </div>
    </section>
    <section>
      <h2>Training & certifications</h2>
      <div>
        {training.map((t) => (
          <article class="experience">
            <div class="item-head">
              <h3>{t.title}</h3>
              <span class="meta">{t.year}</span>
            </div>
            <p>{t.provider}</p>
          </article>
        ))}
      </div>
    </section>
    <section>
      <h2>Contact</h2>
      <p>
        {profile.email}
        <br />
        {profile.location}
      </p>
    </section>
  </div>
</Layout>
<style>
  /* the full name is long at phone width: let it break rather than overflow */
  h1 {
    overflow-wrap: break-word;
    min-width: 0;
    text-wrap: balance;
  }
</style>
<script>
  document.querySelector('#print-profile')?.addEventListener('click', () => window.print());
</script>
