---
import Layout from '../layouts/Layout.astro';
import { profile, experience, teaching, education, training, presentations } from '../data/profile';
import { publications } from '../data/publications';
import PublicationItem from '../components/PublicationItem.astro';
---
<Layout title="Curriculum vitae">
  <div class="wrap cv-page">
    <section class="page-intro">
      <p class="eyebrow">CURRICULUM VITAE</p>
      <h1>{profile.fullName}</h1>
      <p>Assistant Professor · AI Automation · Technology Policy · Applied Research</p>
      <div class="actions"><button class="button print-button" id="print-profile">Print / save CV as PDF</button><a class="text-link" href={`mailto:${profile.email}`}>Email ↗</a></div>
    </section>
    <section class="section cv-section"><h2>Profile</h2><p>Faculty member, researcher, and technology practitioner working across AI automation, IoT, education, technology policy, and digital governance. Experience includes AI-powered workflows, multi-agent systems, applied computing, and emerging technology research.</p></section>
    <section class="section cv-section"><h2>Professional experience</h2><div>{experience.map(e => <article class="experience"><span class="meta">{e.dates}</span><h3>{e.role}</h3><span class="meta">{e.organization}</span><p>{e.detail}</p></article>)}</div></section>
    <section class="section cv-section"><h2>Education</h2><div>{education.map(e => <article class="experience"><span class="meta">{e.dates}</span><h3>{e.degree}</h3><p>{e.institution}<br/>{e.detail}</p></article>)}</div></section>
    <section class="section"><h2>Publications</h2>{publications.map(publication => <PublicationItem publication={publication}/>)}</section>
    <section class="section cv-section"><h2>Conference presentation</h2><div>{presentations.map(p => <article class="experience"><span class="meta">{p.date}</span><h3>{p.title}</h3><p>{p.type} · {p.event}<br/>{p.location}</p></article>)}</div></section>
    <section class="section cv-section"><h2>Teaching & technical practice</h2><div class="prose"><p>{teaching.join(' · ')}</p><p>Zapier · n8n · APIs · LLMs · AI agent workflows · Claude Code · Codex · embedded systems · IoT sensor networks</p></div></section>
    <section class="section cv-section"><h2>Training & certifications</h2><div>{training.map(t => <article class="experience"><span class="meta">{t.year}</span><h3>{t.title}</h3><p>{t.provider}</p></article>)}</div></section>
    <section class="section cv-section"><h2>Contact</h2><p>{profile.email}<br/>{profile.location}</p></section>
  </div>
</Layout>
<script>document.querySelector('#print-profile')?.addEventListener('click', () => window.print());</script>
