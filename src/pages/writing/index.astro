---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { path } from '../../lib/paths';
const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout title="Writing & notes">
  <div class="wrap">
    <section class="page-intro">
      <p class="eyebrow">WRITING / NOTES FROM PRACTICE</p>
      <h1>Thinking in the open.</h1>
      <p>Notes on AI, applied computing, technology policy, and the questions connecting them.</p>
    </section>
    <section class="section">
      {posts.length ? (
        posts.map((post) => (
          <article class="engagement">
            <time class="meta" datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                timeZone: 'UTC',
              })}
            </time>
            <div>
              <h2>
                <a href={path(`writing/${post.id}/`)}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
            </div>
          </article>
        ))
      ) : (
        <div class="empty-state">
          <h2>More to come.</h2>
          <p>No notes published yet. In the meantime, explore my research and work.</p>
          <a class="text-link" href={path('research/')}>
            Explore research ↗
          </a>
        </div>
      )}
    </section>
  </div>
</Layout>
