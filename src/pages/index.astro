---
// Homepage, ported from the approved mockup docs/mockups/e2-automation.html.
import Layout from '../layouts/Layout.astro';
import Terminal from '../components/Terminal.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import WorkflowCard from '../components/WorkflowCard.astro';
import WorkflowDiagram from '../components/WorkflowDiagram.astro';
import { featured, getWorkflows, homeCards } from '../lib/workflows';
import { profile } from '../data/profile';
import { path } from '../lib/paths';
import '../styles/home.css';

const all = getWorkflows();
const feat = featured();
const more = homeCards();
const mailto = `mailto:${profile.email}?subject=${encodeURIComponent('Automation inquiry from your portfolio')}`;
const tag = (order: number) => `WF-${String(order).padStart(2, '0')}`;
---

<Layout>
  <div class="wrap hero">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">
        {profile.academicName}
        <span class="hero-role"> · AI automation</span>
      </p>
      <h1>Hi, I’m Jom, and I automate repetitive tasks.</h1>
      <p class="lede">
        I connect your tools with Zapier, n8n, and AI so the busywork runs itself, saving you up to{' '}
        <strong class="hl">60 hours a month</strong>.
      </p>
      <div class="actions">
        <a class="key key-orange" href={path('work/')}>
          See my workflows
        </a>
      </div>
    </div>
    <Terminal />
  </div>

  <LogoMarquee />

  <section id="work" class="wrap featured" aria-labelledby="feat-title">
    <p class="eyebrow">Featured workflow · Content</p>
    <h2 id="feat-title" class="feature-title">
      {feat.title}
    </h2>
    <div class="device">
      <div class="screen flow-screen">
        <div class="screen-top">
          <span>{tag(feat.order)} · Main path</span>
          <ul class="legend" aria-label="Legend">
            <li>
              <span class="sw sw-ai" aria-hidden="true"></span>AI step
            </li>
            <li>
              <span class="sw sw-human" aria-hidden="true"></span>A person decides
            </li>
          </ul>
        </div>
        <div class="flow flow-row">
          <WorkflowDiagram workflow={feat} variant="featured" />
        </div>
        <div class="flow flow-column">
          <WorkflowDiagram workflow={feat} variant="featured" layout="column" />
        </div>
        {feat.featuredNote && <p class="screen-foot">{feat.featuredNote}</p>}
      </div>
      {feat.beats && (
        <ol class="beats">
          {feat.beats.map((b, i) => (
            <li class:list={{ on: i === 1 }}>
              <b>{b.label}</b>
              {b.text}
            </li>
          ))}
        </ol>
      )}
      <p class="device-foot">
        <a class="textlink" href={path(`work/${feat.slug}/`)}>
          See the full workflow
        </a>
      </p>
    </div>
  </section>

  <section class="wrap" aria-labelledby="lab-title">
    <div class="panel lab">
      <div class="lab-main">
        <p class="eyebrow">Where I built this</p>
        <h2 id="lab-title">Head of Technology &amp; Research, Future AI Lab / BrandNat</h2>
        <p class="lab-meta">2022–2026</p>
        <p class="lab-body">
          I joined Future AI Lab / BrandNat in 2022, just as AI went from a curiosity to a working tool. Over
          four years as Head of Technology &amp; Research, I built through every stage of that shift, from
          hand-wired Zapier automations to AI agents that plan their own steps, for content production and
          audience intelligence.
        </p>
        <p class="lab-link">
          <a class="textlink" href={path('about/')}>
            More about me
          </a>
        </p>
      </div>
      <ol class="lab-list" aria-label="How automation changed, 2022 to 2026">
        <li>
          <span class="stage">First</span>
          <b>Manual automation</b>
          <span>Zapier workflows built by hand, with fixed rules for every step.</span>
        </li>
        <li>
          <span class="stage">Then</span>
          <b>AI-assisted</b>
          <span>AI inside the workflow, reading, sorting, and drafting.</span>
        </li>
        <li class="now">
          <span class="stage">Now</span>
          <b>Agentic</b>
          <span>AI agents that plan steps and use tools, with a person approving what matters.</span>
        </li>
      </ol>
    </div>
  </section>

  <section class="wrap" aria-labelledby="more-title">
    <div class="sec-head">
      <h2 id="more-title">More time-savers</h2>
      <a class="textlink" href={path('work/')}>
        See all {all.length}
      </a>
    </div>
    <div class="cards">
      {more.map((w) => (
        <WorkflowCard workflow={w} />
      ))}
    </div>
  </section>

  <section id="contact" class="wrap contact" aria-labelledby="contact-title">
    <div class="contact-intro">
      <h2 id="contact-title">Got a task that eats your week?</h2>
      <p class="contact-lede">Tell me what it is. I’ll say honestly if it’s worth automating.</p>
    </div>
    <div class="contact-main">
      <form
        id="contact-form"
        class="panel contact-form"
        data-endpoint={profile.contactEndpoint}
        aria-labelledby="contact-title"
        novalidate
      >
        <div class="field-row">
          <div class="field">
            <label for="cf-name">Name</label>
            <input
              id="cf-name"
              name="name"
              type="text"
              autocomplete="name"
              maxlength="100"
              required
              aria-describedby="cf-name-error"
            />
            <p class="field-msg" id="cf-name-error"></p>
          </div>
          <div class="field">
            <label for="cf-email">Email</label>
            <input
              id="cf-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              spellcheck="false"
              maxlength="254"
              required
              aria-describedby="cf-email-error"
            />
            <p class="field-msg" id="cf-email-error"></p>
          </div>
        </div>
        <div class="field">
          <label for="cf-message">What task eats your week?</label>
          <textarea
            id="cf-message"
            name="message"
            rows="5"
            minlength="20"
            maxlength="2000"
            required
            autocomplete="off"
            placeholder="Every Monday I copy new leads from our form into HubSpot…"
            aria-describedby="cf-message-error cf-message-hint"
          ></textarea>
          <div class="field-foot">
            <p class="field-msg" id="cf-message-error"></p>
            <span class="field-count" aria-hidden="true">
              0 / 2000
            </span>
          </div>
          <span class="sr" id="cf-message-hint">
            Between 20 and 2000 characters.
          </span>
        </div>
        <div class="hp" aria-hidden="true">
          <label for="cf-company">Company</label>
          <input id="cf-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="startedAt" value="" />
        <div class="form-foot">
          <button type="submit" class="key key-orange send-key">
            Send it
          </button>
          <p class="form-note">I read every message myself.</p>
        </div>
        <div class="contact-alert" id="contact-alert" role="alert" hidden>
          <span class="alert-text"></span> <a href={mailto}>{profile.email}</a>
        </div>
      </form>

      <div class="contact-status" role="status" aria-live="polite">
        <div class="device contact-done" hidden>
          <div class="screen">
            <div class="screen-top">
              <span aria-hidden="true">Inquiry · Sent</span>
              <span aria-hidden="true">Contact form</span>
            </div>
            <div class="cd-body">
              <h3 class="t-prompt cd-title" tabindex="-1">
                <span class="t-caret" aria-hidden="true">
                  &gt;
                </span>
                <span>Message sent</span>
              </h3>
              <ol class="t-steps cd-steps">
                {['Inquiry received', 'AI triaged your request', 'Jom notified'].map((label) => (
                  <li class="t-done">
                    <span class="t-tree" aria-hidden="true">
                      ⎿
                    </span>
                    <span class="t-ok" aria-hidden="true">
                      ✓
                    </span>
                    {label}
                  </li>
                ))}
              </ol>
            </div>
          </div>
          <p class="cd-note">
            Thanks — I’ll reply within one working day. A confirmation is on its way to your inbox.
          </p>
        </div>
      </div>

      <div class="contact-fallback">
        <span>Prefer email?</span>
        <a class="fallback-mail" href={mailto}>
          {profile.email}
        </a>
        <button type="button" class="copy-key" data-copy={profile.email} aria-label="Copy email address">
          <span class="copy-idle">Copy</span>
          <span class="copy-done" aria-hidden="true">
            Copied ✓
          </span>
        </button>
        <span class="sr copy-status" role="status"></span>
      </div>
    </div>
  </section>
</Layout>

<script>
  import '../scripts/workflow-anim';
  import '../scripts/contact-form';
</script>
