---
// Hero terminal. Server-rendered in its final state (every step done + summary) so it reads
// complete without JS or under reduced motion; src/scripts/terminal.ts replays the run.
const prompt = "automate: find today's best stories → score → vote";
// One spinner verb per step; the first step cycles through two sources before it completes.
const steps = [
  {
    verbs: ['Searching Hacker News…', 'Reading Reddit…'],
    label: 'Pulled stories from Hacker News, Reddit, and the web',
    ms: 1700,
  },
  { verbs: ['Scoring with AI…'], label: 'AI scored every story', ms: 1600 },
  { verbs: ['Waiting for your vote…'], label: 'Sent the best to Slack: Keep or Kill', ms: 2100 },
  { verbs: ['Sending to scripts…'], label: 'Kept stories sent to the script writer', ms: 1400 },
];
---

<div class="device term">
  <div class="screen">
    <div class="screen-top">
      <span aria-hidden="true">WF-01 · Example run</span>
      <span aria-hidden="true">Story scout</span>
      <button type="button" class="motion-toggle" aria-pressed="false" hidden>
        Pause motion
      </button>
    </div>
    <div
      class="term-body"
      role="img"
      aria-label="Example automation run: stories are pulled from Hacker News, Reddit, and the web, AI scores every story, the best are sent to Slack for a Keep or Kill vote, and kept stories go to the script writer."
    >
      <p class="t-prompt">
        <span class="t-caret">&gt;</span>
        <span class="t-text">
          <span class="t-ghost">{prompt}</span>
          <span class="t-typed">{prompt}</span>
        </span>
      </p>
      <ol class="t-steps">
        {steps.map((s) => (
          <li class="t-done" data-verb={s.verbs.join('|')} data-label={s.label} data-ms={s.ms}>
            <span class="t-tree">⎿</span>
            <span class="t-ok">✓</span>
            {s.label}
          </li>
        ))}
        <li class="t-sum">
          <b>Done</b> · 4 steps · scripts next
        </li>
      </ol>
    </div>
  </div>
</div>

<script>
  import '../scripts/terminal';
  import '../scripts/motion-toggle';
</script>
