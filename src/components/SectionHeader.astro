---
interface Props { number: string; title: string; href?: string; label?: string; }
const { number, title, href, label } = Astro.props;
---
<div class="section-heading"><div><p class="eyebrow">{number}</p><h2>{title.split('<br/>').map((line, i) => <>{i > 0 && <br/>}{line}</>)}</h2></div>{href && <a class="text-link" href={href}>{label} <span aria-hidden="true">↗</span></a>}</div>
