---
import type { publications } from '../data/publications';
interface Props {
  publication: (typeof publications)[number];
}
const { publication: p } = Astro.props;
---

<article class="publication">
  <div class="meta">
    {p.year}
    <br />
    {p.type}
  </div>
  <div>
    <h3>
      <a href={`https://doi.org/${p.doi}`}>
        {p.title} <span aria-hidden="true">↗</span>
      </a>
    </h3>
    <p class="authors">{p.authors}</p>
    <p>{p.venue}</p>
    <a class="text-link" href={`https://doi.org/${p.doi}`}>
      DOI: {p.doi}
    </a>
  </div>
</article>
